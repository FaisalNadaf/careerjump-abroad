# Waitlist form endpoint (required for submissions).
# The form POSTs a JSON body with Content-Type text/plain (a CORS "simple request").
# See docs/waitlist-backend.md for the expected response contract.
# NOTE: every VITE_* value is compiled into the public JavaScript bundle.
# Never put a secret in a VITE_* variable. This endpoint URL is public by design.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbyi2omsmehJy3nhKKffTYy0dWYXJo1uzz991517KFiG318ZV_84J6YHUaiiDTr_4cazrA/exec

# Public production URL, e.g. https://www.example.com (optional).
# When set, the build adds a canonical link, og:url and absolute social image URLs.
# Leave empty until the production domain is confirmed.
VITE_SITE_URL=

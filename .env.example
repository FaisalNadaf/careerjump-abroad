# Waitlist form endpoint (required for submissions).
# Set this to the /exec URL of your deployment of apps-script/Code.gs, which saves
# registrations to a Google Sheet. Setup: docs/waitlist-backend.md#google-sheet-setup
# Verify with: npm run check:waitlist
# NOTE: every VITE_* value is compiled into the public JavaScript bundle.
# Never put a secret in a VITE_* variable. This endpoint URL is public by design.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbxaNAL1qMylufvHHAFtZQ6wYiM_5XXY_x8QfmgI-ps8VCjAV_utwV_pP_-KAf4xKmiz/exec

# Public production URL, without a trailing path (optional).
# When set, the build adds a canonical link, og:url, absolute social image URLs,
# sitemap.xml and a Sitemap line in robots.txt.
VITE_SITE_URL=https://careerjump.co.in
